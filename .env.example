# =============================================================================
# Crime Board — Plantilla de variables de entorno
# Hito 2 · Fase 2
# =============================================================================
# Copia esta plantilla y ajusta los valores:
#
#   cp .env.example .env          # Linux / macOS / Git Bash
#   Copy-Item .env.example .env   # PowerShell
#
# El archivo .env NO se versiona (ver .gitignore). Este archivo solo contiene
# valores por defecto de DESARROLLO. Nunca incluyas secretos reales aquí.
# =============================================================================

# -----------------------------------------------------------------------------
# Proyecto y entorno
# -----------------------------------------------------------------------------
# Prefijo de los recursos Docker (redes, volúmenes, contenedores).
COMPOSE_PROJECT_NAME=crime-board

# development | staging | production
ENVIRONMENT=development

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Etiqueta de las imágenes construidas localmente. En CI/CD usa el SHA o la
# versión semántica del release (p. ej. 1.4.0).
IMAGE_TAG=local

# Interfaz del host donde se publican los puertos de los microservicios.
# 127.0.0.1 = solo accesible desde la propia máquina (recomendado en local).
# 0.0.0.0   = accesible desde la red; úsalo solo si lo necesitas.
BIND_ADDRESS=127.0.0.1

# -----------------------------------------------------------------------------
# Puertos publicados en el host
# -----------------------------------------------------------------------------
# Todos los servicios escuchan en el puerto 8000 DENTRO de la red Docker.
LEVEL_MANAGEMENT_HOST_PORT=8000
PLAYGROUND_ENGINE_HOST_PORT=8001
USER_SERVICE_HOST_PORT=8002
RATING_SERVICE_HOST_PORT=8003
PROGRESS_SERVICE_HOST_PORT=8004

# Solo se usan si descomentas los mapeos opcionales de PostgreSQL/Redis
# en compose.yaml (acceso de depuración desde el host).
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379

# -----------------------------------------------------------------------------
# PostgreSQL — Level Management Service
# -----------------------------------------------------------------------------
# Nombre DNS interno del contenedor dentro de db-net.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=crimeboard
POSTGRES_USER=crimeboard

# Contraseña de desarrollo. Cámbiala antes de compartir el entorno.
# Usa solo caracteres seguros para URL ([A-Za-z0-9_-]): compose.yaml
# construye DATABASE_URL a partir de este valor y los caracteres especiales
# (:@/?#%) romperían la cadena de conexión.
POSTGRES_PASSWORD=crimeboard_dev_change_me

# -----------------------------------------------------------------------------
# Redis — Playground Engine Service
# -----------------------------------------------------------------------------
# Nombre DNS interno del contenedor dentro de cache-net.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Contraseña de desarrollo (se aplica con --requirepass).
REDIS_PASSWORD=crimeboard_dev_redis_change_me

# Límite de memoria del caché y política de expulsión.
# Ajusta según la carga; allkeys-lru es adecuada para datos efímeros.
REDIS_MAXMEMORY=256mb

# -----------------------------------------------------------------------------
# URLs internas entre microservicios (backend-net)
# -----------------------------------------------------------------------------
# El Playground Engine resuelve el catálogo de niveles por DNS interno.
LEVEL_MANAGEMENT_SERVICE_URL=http://level-management-service:8000
PLAYGROUND_ENGINE_SERVICE_URL=http://playground-engine-service:8000
# User Service: registro, login y emisión de JWT.
USER_SERVICE_URL=http://user-service:8000
# Rating Service: medias y votos de los niveles (lectura pública, voto con JWT).
RATING_SERVICE_URL=http://rating-service:8000
# Progress Service: libreta, sesiones, intentos y estadísticas (solo con JWT).
PROGRESS_SERVICE_URL=http://progress-service:8000
# El motor registra cada acusación autenticada; con false solo valida.
PROGRESS_ENABLED=true
# Timeout corto: el registro es fail-open y nunca bloquea el veredicto.
PROGRESS_TIMEOUT_SECONDS=0.8

# -----------------------------------------------------------------------------
# Seguridad de la aplicación
# -----------------------------------------------------------------------------
# Clave para firmar sesiones/tokens. DEBE ser aleatoria y distinta por entorno.
# Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=dev_only_replace_me_00000000000000000000000000000000

# --- JWT compartido entre user-service y level-management-service -------------
# user-service firma los tokens; level-management los verifica localmente.
# Si se omite JWT_SECRET_KEY, ambos servicios usan APP_SECRET_KEY.
# Genera una clave propia con:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=dev_only_replace_me_00000000000000000000000000000000
JWT_ALGORITHM=HS256
JWT_ISSUER=crime-board-user-service
# Vigencia del token en minutos (720 = 12 horas).
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- Clave interna entre microservicios ---------------------------------------
# Protege los endpoints internos (solución del nivel, intentos y purga). Si se
# omite, se usa APP_SECRET_KEY, igual que el resto de secretos compartidos.
# No la expongas al frontend.
INTERNAL_API_KEY=dev_only_replace_me_00000000000000000000000000000000

# -----------------------------------------------------------------------------
# CORS — acceso del tablero (frontend estático)
# -----------------------------------------------------------------------------
# Orígenes autorizados a llamar a los microservicios desde el navegador.
# Sin valor se permite cualquiera (*), ideal para abrir frontend/index.html
# en local o servirlo con python -m http.server.
# En producción fija la lista exacta separada por comas, por ejemplo:
#   CORS_ALLOW_ORIGINS=https://crimeboard.example.com,https://admin.example.com
CORS_ALLOW_ORIGINS=*

# =============================================================================
# Conexiones derivadas (solo referencia)
# =============================================================================
# compose.yaml construye estas URLs a partir de las variables anteriores y las
# inyecta en los contenedores. Se muestran aquí para que sepas exactamente qué
# recibe cada servicio; no es necesario definirlas en .env.
#
# DATABASE_URL=postgresql+asyncpg://crimeboard:crimeboard_dev_change_me@postgres:5432/crimeboard
# REDIS_URL=redis://:crimeboard_dev_redis_change_me@redis:6379/0
#
# Si cambias POSTGRES_* o REDIS_*, las URLs se recalculan automáticamente.
# =============================================================================
